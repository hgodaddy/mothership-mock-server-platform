# MMSP Sprint 1 Java POC — Environment Variables
PORT=8080
HOST=0.0.0.0
PLATFORM_NAME=MMSP
PLATFORM_VERSION=0.1.0
API_PREFIX=/api/v1
DEFAULT_SCENARIO=success
DEFAULT_LATENCY_MS=50

# Runtime state: false = in-memory (default for native Path A)
# Docker Compose sets REDIS_ENABLED=true and REDIS_URL=redis://redis:6379
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

LOG_LEVEL=INFO
REQUEST_LOGGING=true
METRICS_ENABLED=true

# Optional API key auth — disabled by default for local POC
MMSP_API_KEY_ENABLED=false
MMSP_API_KEY=
MMSP_API_KEY_HEADER=X-API-Key
